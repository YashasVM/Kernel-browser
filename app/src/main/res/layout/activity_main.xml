<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kernel_background"
    android:fitsSystemWindows="true">

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/geckoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/kernel_accent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottomChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/browser_chrome_background"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/addressPill"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/address_bar_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_shield"
                android:tint="@color/kernel_muted" />

            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:autofillHints="url"
                android:background="@android:color/transparent"
                android:hint="@string/address_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri|textNoSuggestions"
                android:paddingStart="0dp"
                android:paddingEnd="6dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/kernel_text"
                android:textColorHint="@color/kernel_muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/reloadButton"
                style="@style/AddressActionButton"
                android:drawableTop="@drawable/ic_refresh" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/backButton"
                style="@style/BrowserIconButton"
                android:drawableTop="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/forwardButton"
                style="@style/BrowserIconButton"
                android:drawableTop="@drawable/ic_arrow_forward" />

            <TextView
                android:id="@+id/homeButton"
                style="@style/BrowserIconButton"
                android:drawableTop="@drawable/ic_home" />

            <TextView
                android:id="@+id/extensionsButton"
                style="@style/BrowserIconButton"
                android:drawableTop="@drawable/ic_extension" />

            <TextView
                android:id="@+id/tabsButton"
                style="@style/BrowserIconButton"
                android:drawableTop="@drawable/ic_tabs" />

            <TextView
                android:id="@+id/settingsButton"
                style="@style/BrowserIconButton"
                android:drawableTop="@drawable/ic_settings" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
